# Nom de domaine qui pointe vers le serveur (enregistrement DNS A/AAAA)
DOMAIN=finpilot.mondomaine.fr
# Mot de passe de la base (long et aléatoire)
POSTGRES_PASSWORD=changez-moi
# Clé secrète Django : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=0
# Notifications : docker compose run --rm api python manage.py generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.fr
# Seulement si l'application est servie depuis un autre domaine (ex. Firebase Hosting)
FINPILOT_CORS_ORIGINS=
# Inscriptions : invite (code requis, recommandé), open (libre) ou closed. Le premier compte créé devient administrateur.
FINPILOT_REGISTRATION=invite
# Espace de stockage par compte (Mo, données chiffrées et documents)
FINPILOT_QUOTA_MB=250
FINPILOT_PUBLIC_URL=https://finpilot.mondomaine.fr
# Facultatif : envoi des codes « mot de passe oublié » par e-mail (sinon l'administrateur les génère)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FINPILOT <no-reply@mondomaine.fr>
